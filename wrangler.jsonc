{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "magniom-web",
  "main": "apps/web/.open-next/worker.js",
  "compatibility_date": "2025-02-14",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "apps/web/.open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  }
}
