      "safetyClass": "major",
      "appliesToMode": "all",
      "verificationMethod": "golden_case",
      "riskControlIds": ["HAZ-002", "HAZ-003"],
      "status": "approved"
    },
    {
      "id": "MAG-VAL-002",
      "domain": "VAL",
      "statement": "Target Engine execution shall produce identical candidate coordinates, confidence scores, and slates across 1000 repeated runs given identical inputs.",
