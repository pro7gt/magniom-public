    {
      "id": "MAG-REL-026",
      "domain": "REL",
      "statement": "A Clinical Release Package SHALL identify the exact combination of SRS, Clinical & Scientific Spec, Canonical Target Data Spec, Phenotype Ontology, Evidence Library, Policy, Target Engine, Neuro Pipeline, Normative Model, Atlas, DB Migration, and UX workspace.",
