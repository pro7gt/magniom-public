      "riskControlIds": ["HAZ-003"],
      "status": "approved"
    },
    {
      "id": "MAG-REL-012",
      "domain": "REL",
      "statement": "Feature and scientific changes after M3 freeze SHALL undergo formal change-control impact assessment.",
      "sourceSpecification": [
        "MAGNIOM-System Requirements Specification v1.0",
        "MAGNIOM-Implementation & Validation Roadmap v1.0"
      ],
