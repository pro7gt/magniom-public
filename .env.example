# ==============================================
# MAGNIOM SYSTEM ENVIRONMENT CONFIGURATION
# ==============================================

# Mode: RESEARCH (Permissive/Exploratory) | CLINICAL (Strict Regulatory Gating) | VALIDATION
MAGNIOM_MODE=RESEARCH

# Environment: local | ci | development | staging | production
MAGNIOM_ENV=local
NODE_ENV=development

# Next.js Port
PORT=3000

# Supabase Local Configuration
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.dummy_anon_key_for_local_dev
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.dummy_service_role_key_for_local_dev
SUPABASE_DB_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Scientific Policy & Evidence Release Pinned Defaults
PINNED_SCIENTIFIC_POLICY_VERSION=MAGNIOM-POLICY-0.1.0-SYNTHETIC
PINNED_EVIDENCE_RELEASE_VERSION=MAGNIOM-EVIDENCE-DEV-1.0.0
