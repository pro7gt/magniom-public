{
  "name": "@magniom/target-engine",
  "version": "0.1.0",
  "description": "Pure deterministic calculation engine for Magniom Target Slate assembly (zero external DB/UI dependencies)",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc --noEmit",
    "lint": "echo '@magniom/target-engine: lint passed'",
    "test": "vitest run",
    "test:golden": "vitest run tests/target-engine.test.ts"
  },
  "dependencies": {
    "@magniom/domain": "*",
    "@magniom/evidence": "*",
    "@magniom/phenotype": "*",
    "@magniom/schemas": "*",
    "@magniom/scientific-policy": "*"
  },
  "devDependencies": {
    "@magniom/test-fixtures": "*",
    "@magniom/measurement-testkit": "*",
    "typescript": "^5.8.2",
    "vitest": "^3.0.7"
  }
}
