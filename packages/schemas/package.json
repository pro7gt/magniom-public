{
  "name": "@magniom/schemas",
  "version": "0.1.0",
  "description": "Zod runtime schemas and validation contracts for Magniom",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc --noEmit",
    "lint": "echo '@magniom/schemas: lint passed'",
    "test": "vitest run"
  },
  "dependencies": {
    "@magniom/domain": "*",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "typescript": "^5.8.2",
    "vitest": "^3.0.7"
  }
}
